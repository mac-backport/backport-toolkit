set dvdcss_dist     libdvdcss-1.4.2-Leia-Beta-5.tar.gz
set dvdread_dist    libdvdread-6.0.0-Leia-Alpha-3.tar.gz
set dvdnav_dist     libdvdnav-6.0.0-Leia-Alpha-3.tar.gz

distfiles           ${kodi_dist} ${crossguid_dist} ${flatbuf_dist} ${fmt_dist} \
                    ${fstrcmp_dist} ${ffmpeg_dist} ${dvdcss_dist} \
                    ${dvdread_dist} ${dvdnav_dist}

# Give every upstream archive a stable, unique local name. The checksum phase
# below remains the authority; CMake receives only these verified local files.
fetch {
    xinstall -d ${distpath}
    set archives [list \
        ${kodi_dist}      https://github.com/xbmc/xbmc/archive/refs/tags/18.9-Leia.tar.gz \
        ${crossguid_dist} https://mirrors.kodi.tv/build-deps/sources/crossguid-8f399e8bd4.tar.gz \
        ${flatbuf_dist}   https://mirrors.kodi.tv/build-deps/sources/flatbuffers-1.9.0.tar.gz \
        ${fmt_dist}       https://mirrors.kodi.tv/build-deps/sources/fmt-5.1.0.tar.gz \
        ${fstrcmp_dist}   https://mirrors.kodi.tv/build-deps/sources/fstrcmp-0.7.D001.tar.gz \
        ${ffmpeg_dist}    https://github.com/xbmc/FFmpeg/archive/4.0.4-Leia-18.4.tar.gz \
        ${dvdcss_dist}    https://github.com/xbmc/libdvdcss/archive/1.4.2-Leia-Beta-5.tar.gz \
        ${dvdread_dist}   https://github.com/xbmc/libdvdread/archive/6.0.0-Leia-Alpha-3.tar.gz \
        ${dvdnav_dist}    https://github.com/xbmc/libdvdnav/archive/6.0.0-Leia-Alpha-3.tar.gz]
    foreach {archive url} ${archives} {
        if {![file exists ${distpath}/${archive}]} {
            system "${prefix}/bin/curl -L --fail --retry 3 -o ${distpath}/${archive} ${url}"
        }
    }
}

