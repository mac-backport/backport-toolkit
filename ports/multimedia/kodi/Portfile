build.env-append    MACOSX_DEPLOYMENT_TARGET=10.9
destroot.env-append MACOSX_DEPLOYMENT_TARGET=10.9

destroot {
    system -W ${build.dir} "${build.cmd} bundle"
    set source_app ${build.dir}/build/MacPorts/Kodi.app
    if {![file exists ${source_app}/Contents/MacOS/Kodi]} {
        return -code error "Kodi bundle target did not produce Kodi.app"
    }
    xinstall -d ${destroot}/Applications
    copy ${source_app} ${destroot}/Applications/Kodi.app
}

post-destroot {
    set app ${destroot}/Applications/Kodi.app
    if {![file exists ${app}/Contents/MacOS/Kodi]} {
        return -code error "Kodi.app was not produced by the destroot phase"
    }
    # Kodi's bundle script does not visit these two nonstandard locations.
    # Keep both relocatable instead of retaining a dependency on /opt/local.
    system "/usr/bin/install_name_tool -change ${prefix}/lib/libcxx/libc++.1.0.dylib @loader_path/../../../Libraries/libc++.1.0.dylib ${app}/Contents/Resources/Kodi/system/libsse4-x86-osx.dylib"
    system "/usr/bin/install_name_tool -change ${prefix}/lib/libcxx/libc++.1.0.dylib @loader_path/../../../../../Libraries/libc++.1.0.dylib ${app}/Contents/Resources/Kodi/tools/darwin/runtime/XBMCHelper"
    system "/usr/bin/install_name_tool -change @executable_path/../Libraries/libc++abi.1.dylib @loader_path/libc++abi.1.dylib ${app}/Contents/Libraries/libc++.1.0.dylib"
    # rev6: macports-libcxx rev1 haengt nicht mehr an libunwind.1 (System-Unwinder),
    # die frueheren libunwind-Relinks entfallen. Guard gegen den Unwinder-Mix, der
    # bis rev5 jede Python-Addon-Exception zum SIGSEGV gemacht hat:
    foreach lib {libc++.1.0.dylib libc++abi.1.dylib} {
        if {![catch {exec /usr/bin/otool -L ${app}/Contents/Libraries/${lib} | grep -q libunwind}]} {
            return -code error "${lib} im Bundle linkt libunwind.1 (Unwinder-Mix) -> erst macports-libcxx rev1 installieren"
        }
    }
    file delete -force ${app}/Contents/Libraries/libunwind.1.dylib

    # Preserve this host's active Estuary customisation as a reproducible
    # overlay. Historical *.bak files intentionally remain outside the app.
    set skin ${app}/Contents/Resources/Kodi/addons/skin.estuary
    foreach skinfile [glob ${filespath}/skin-estuary-overlay/xml/*.xml] {
        copy -force ${skinfile} ${skin}/xml/[file tail ${skinfile}]
    }
    xinstall -d ${skin}/media/icons/sidemenu
    foreach skinasset [glob ${filespath}/skin-estuary-overlay/media/icons/sidemenu/*.png] {
        copy -force ${skinasset} ${skin}/media/icons/sidemenu/[file tail ${skinasset}]
    }
    foreach themedirectory [list \
        curial/buttons curial/dialogs curial/lists curial/overlays \
        flat/buttons flat/dialogs flat/overlays] {
        xinstall -d ${skin}/themes/${themedirectory}
    }
    system "/usr/bin/otool -l ${app}/Contents/MacOS/Kodi | /usr/bin/grep -A3 LC_VERSION_MIN_MACOSX | /usr/bin/grep -q 'version 10.9'"
}
