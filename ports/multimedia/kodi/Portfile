                    -DFLATBUFFERS_URL=${distpath}/${flatbuf_dist} \
                    -DFMT_URL=${distpath}/${fmt_dist} \
                    -DFSTRCMP_URL=${distpath}/${fstrcmp_dist} \
                    -DFFMPEG_URL=${distpath}/${ffmpeg_dist} \
                    -DLIBDVDCSS_URL=${distpath}/${dvdcss_dist} \
                    -DLIBDVDREAD_URL=${distpath}/${dvdread_dist} \
