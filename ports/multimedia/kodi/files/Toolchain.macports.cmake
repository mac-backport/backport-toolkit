set(OS "osx")
set(CORE_SYSTEM_NAME osx)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CPU "x86_64")
set(CMAKE_OSX_DEPLOYMENT_TARGET "10.9" CACHE STRING "" FORCE)
set(CMAKE_OSX_ARCHITECTURES "x86_64" CACHE STRING "" FORCE)
set(CMAKE_C_COMPILER "/opt/local/bin/clang-mp-22")
set(CMAKE_CXX_COMPILER "/opt/local/bin/clang++-mp-22")
set(CMAKE_AR "/opt/local/bin/ar" CACHE FILEPATH "")
set(CMAKE_RANLIB "/opt/local/bin/ranlib" CACHE FILEPATH "")
set(CMAKE_STRIP "/opt/local/bin/strip" CACHE FILEPATH "")
set(CMAKE_FIND_ROOT_PATH "/opt/local")
set(CMAKE_PREFIX_PATH "/opt/local")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
set(CMAKE_FIND_FRAMEWORK LAST)
set(DEPENDS_PATH "/opt/local")
set(NATIVEPREFIX "/opt/local")
