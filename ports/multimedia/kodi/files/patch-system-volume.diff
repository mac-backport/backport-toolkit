+static bool Cocoa_GetDefaultOutputDevice(AudioDeviceID *device)
+{
+  AudioObjectPropertyAddress address = {
+    kAudioHardwarePropertyDefaultOutputDevice,
+    kAudioObjectPropertyScopeGlobal,
+    kAudioObjectPropertyElementMaster
+  };
+  UInt32 size = sizeof(*device);
+  return AudioObjectGetPropertyData(kAudioObjectSystemObject, &address, 0, NULL,
+                                    &size, device) == noErr &&
+         *device != kAudioObjectUnknown;
+}
+
+static bool Cocoa_GetOutputProperty(AudioObjectPropertySelector selector, UInt32 element,
+                                    Float32 *value)
+{
+  AudioDeviceID device;
+  if (!Cocoa_GetDefaultOutputDevice(&device))
+    return false;
+
+  AudioObjectPropertyAddress address = {
+    selector, kAudioDevicePropertyScopeOutput, element
+  };
+  UInt32 size = sizeof(*value);
+  return AudioObjectHasProperty(device, &address) &&
+         AudioObjectGetPropertyData(device, &address, 0, NULL, &size, value) == noErr;
+}
+
+static bool Cocoa_SetOutputProperty(AudioObjectPropertySelector selector, UInt32 element,
+                                    Float32 value)
+{
+  AudioDeviceID device;
+  if (!Cocoa_GetDefaultOutputDevice(&device))
+    return false;
+
+  AudioObjectPropertyAddress address = {
+    selector, kAudioDevicePropertyScopeOutput, element
+  };
+  Boolean writable = false;
+  if (!AudioObjectHasProperty(device, &address) ||
+      AudioObjectIsPropertySettable(device, &address, &writable) != noErr || !writable)
+    return false;
+  return AudioObjectSetPropertyData(device, &address, 0, NULL, sizeof(value), &value) == noErr;
+}
+
+static bool Cocoa_GetOutputUInt32(AudioObjectPropertySelector selector, UInt32 *value)
+{
+  AudioDeviceID device;
+  if (!Cocoa_GetDefaultOutputDevice(&device))
+    return false;
+  AudioObjectPropertyAddress address = {
+    selector, kAudioDevicePropertyScopeOutput, kAudioObjectPropertyElementMaster
+  };
+  UInt32 size = sizeof(*value);
+  return AudioObjectHasProperty(device, &address) &&
+         AudioObjectGetPropertyData(device, &address, 0, NULL, &size, value) == noErr;
+}
+
+static bool Cocoa_SetOutputUInt32(AudioObjectPropertySelector selector, UInt32 value)
+{
+  AudioDeviceID device;
+  if (!Cocoa_GetDefaultOutputDevice(&device))
+    return false;
+  AudioObjectPropertyAddress address = {
+    selector, kAudioDevicePropertyScopeOutput, kAudioObjectPropertyElementMaster
+  };
+  Boolean writable = false;
+  if (!AudioObjectHasProperty(device, &address) ||
+      AudioObjectIsPropertySettable(device, &address, &writable) != noErr || !writable)
+    return false;
+  return AudioObjectSetPropertyData(device, &address, 0, NULL, sizeof(value), &value) == noErr;
+}
+
+bool Cocoa_GetSystemVolume(float *volume)
+{
+  if (!volume)
+    return false;
+  Float32 value;
+  if (Cocoa_GetOutputProperty(kAudioDevicePropertyVolumeScalar,
+                              kAudioObjectPropertyElementMaster, &value))
+  {
+    *volume = value;
+    return true;
+  }
+
+  Float32 left, right;
+  if (Cocoa_GetOutputProperty(kAudioDevicePropertyVolumeScalar, 1, &left) &&
+      Cocoa_GetOutputProperty(kAudioDevicePropertyVolumeScalar, 2, &right))
+  {
+    *volume = (left + right) / 2.0f;
+    return true;
+  }
+  return false;
+}
+
+bool Cocoa_SetSystemVolume(float volume)
+{
+  volume = std::max(0.0f, std::min(1.0f, volume));
+  if (Cocoa_SetOutputProperty(kAudioDevicePropertyVolumeScalar,
+                              kAudioObjectPropertyElementMaster, volume))
+    return true;
+
+  const bool left = Cocoa_SetOutputProperty(kAudioDevicePropertyVolumeScalar, 1, volume);
+  const bool right = Cocoa_SetOutputProperty(kAudioDevicePropertyVolumeScalar, 2, volume);
+  return left && right;
+}
+
+bool Cocoa_GetSystemMute(bool *muted)
+{
+  if (!muted)
+    return false;
+  UInt32 value;
+  if (!Cocoa_GetOutputUInt32(kAudioDevicePropertyMute, &value))
+    return false;
+  *muted = value != 0.0f;
+  return true;
+}
+
+bool Cocoa_SetSystemMute(bool muted)
+{
+  return Cocoa_SetOutputUInt32(kAudioDevicePropertyMute, muted ? 1 : 0);
+}
