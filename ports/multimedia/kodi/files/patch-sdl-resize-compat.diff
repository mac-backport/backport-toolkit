-extern "C" void SDL_SetWidthHeight(int w, int h);
+static void SDL_SetWidthHeightCompat(int width, int height)
+{
+  // Kodi's historical bundled SDL carried a private SDL_SetWidthHeight()
+  // helper. Keep the same bookkeeping while using the stock MacPorts SDL.
+  SDL_Surface* screen = SDL_GetVideoSurface();
+  if (screen)
+  {
+    screen->w = width;
+    screen->h = height;
+  }
+}
