# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           active_variants 1.1

# backport-toolkit overlay: Sofa -- turn an old iMac into a web TV.
# Native Cocoa smart-TV app for OS X 10.9 with the Apple Remote: YouTube, ZDF, ARD,
# ORF, media.ccc.de. Main use case of this overlay (clang-22, curl/OpenSSL for
# TLS 1.3, mpv/libmpv for VP9/AV1, python314 for yt-dlp).
github.setup        robertkleinschuster sofa 0.3.9 v
github.tarball_from archive
revision            0

# Bundled into Sofa.app at build time, fetched as checksummed distfiles (no network while
# building): yt-dlp as pinned in res/ytdlp.lock (Sofa's build verifies the maintainers' GPG
# signature over SHA2-256SUMS on top), and the YouTube sidecar's npm dependencies exactly as in
# res/sofa-yt/package-lock.json (release asset; tools/fetch-sofa-yt checks it against the lockfile).
set ytdlp_version   2026.10.26
set sofa_yt_modules sofa-yt-modules-0b2499bc14b6.tar.gz
dist_subdir         ${name}/${version}
master_sites-append https://github.com/yt-dlp/yt-dlp/releases/download/${ytdlp_version}/:ytdlp \
                    https://github.com/robertkleinschuster/sofa/releases/download/v${version}/:sofayt
distfiles-append    yt-dlp:ytdlp SHA2-256SUMS:ytdlp SHA2-256SUMS.sig:ytdlp ${sofa_yt_modules}:sofayt
extract.only        ${distname}${extract.suffix}

categories          multimedia aqua
license             GPL-3+
maintainers         nomaintainer
supported_archs     x86_64
platforms           {darwin >= 13}
description         Turn an old iMac into a web TV (Apple Remote, YouTube, Mediatheken)
long_description    Sofa is a native smart-TV app for old Intel Macs on OS X 10.9, \
                    operated with the 7-button Apple Remote: YouTube (subscriptions, \
                    Watch Later, phone pairing), ZDF, ARD, ORF and media.ccc.de, \
                    following shows, automatic downloads, H.264 in hardware and \
                    VP9/AV1 via libmpv.
homepage            https://github.com/robertkleinschuster/sofa

checksums           ${distname}${extract.suffix} \
                    rmd160  1b8cd42cc9083e6d0ee5286ee3c5dbc69e6230b5 \
                    sha256  91d6248551a3c082b074f7da1902d20be7b38e767516ab2b9b6fdc29be03f409 \
                    size    4362676 \
                    yt-dlp \
                    rmd160  fdd37b5e26b713653a0010ea92f4221869978fc6 \
                    sha256  e51e69e89489f199530f13d32a4342da3ddb2cf34842f364603a066db05afbf3 \
                    size    3073072 \
                    SHA2-256SUMS \
                    rmd160  8d6c8a7c59c4f1779b960c1d6763057df35fb81f \
                    sha256  0d7ec4303a02bcbe66154d478852cdf2e07688d39dc4597316e4424ac4e74356 \
                    size    1595 \
                    SHA2-256SUMS.sig \
                    rmd160  cb57ac85fcf161a045b9ad1da89863da63208b45 \
                    sha256  f05740ee44224bc5ccd5571ae2b526e91a5c22fdbb5335f1351ba9d928d877cb \
                    size    566 \
                    ${sofa_yt_modules} \
                    rmd160  58cc46e8e7fb4aa8b1ea1912cd8eb8c342f690ca \
                    sha256  c06ae29c199069d6cd7ff479803cf2c0823293f20ca8a2997c056063962055b8 \
                    size    6431002

compiler.whitelist  macports-clang-22

# nodejs26 runs the YouTube sidecar (TypeScript, native type stripping; it also mints the PO
# tokens for the yt-dlp fallback - no separate token server since 0.3.8) and solves YouTube's JS
# challenge for yt-dlp; python314 runs yt-dlp.
depends_lib         port:curl \
                    port:sqlite3 \
                    port:mpv \
                    port:ffmpeg \
                    port:nodejs26 \
                    port:librsvg \
                    port:python314

require_active_variants mpv libmpv

post-patch {
    # tools Sofa calls (ffmpeg, node, rsvg-convert, python3.14) and headers/libs: MacPorts prefix
    foreach f [concat [glob ${worksrcpath}/src/*/*.m ${worksrcpath}/helper/*.m] ${worksrcpath}/res/ytresolver.py] {
        reinplace -q "s|/opt/local|${prefix}|g" ${f}
    }
    # LaunchAgents point to the installed app
    reinplace "s|/Applications/Sofa.app|${applications_dir}/Sofa.app|g" \
        ${worksrcpath}/res/launchd/de.sofa.app.plist \
        ${worksrcpath}/res/launchd/de.sofa.remote.plist
}

use_configure       no
build.args          CC=${configure.cc} MP=${prefix}
build.env-append    SOFA_DISTFILES=${distpath} \
                    NODE_BIN=${prefix}/bin \
                    PYTHON=${prefix}/bin/python3.14

destroot {
    xinstall -d ${destroot}${applications_dir}
    copy ${worksrcpath}/build/Sofa.app ${destroot}${applications_dir}/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${worksrcpath}/LICENSE ${destroot}${prefix}/share/doc/${name}/
}

# Two per-user LaunchAgents (sudo port load sofa):
#   de.sofa.remote -- SofaRemote helper: Apple IR receiver, MENU opens Sofa, live updates
#   de.sofa.app    -- start Sofa at login, restart after a crash
startupitem.create  yes
startupitems        name        sofa-remote \
                    location    LaunchAgents \
                    uniquename  de.sofa.remote \
                    custom_file ${worksrcpath}/res/launchd/de.sofa.remote.plist \
                    name        sofa \
                    location    LaunchAgents \
                    uniquename  de.sofa.app \
                    custom_file ${worksrcpath}/res/launchd/de.sofa.app.plist

livecheck.type      none
