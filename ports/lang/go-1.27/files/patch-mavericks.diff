+func x509_dlsym_trampoline()
+
+// kCFTypeArrayCallBacksAddr is &kCFTypeArrayCallBacks, resolved once at init via
+// dlsym. Mavericks backport: on macOS 10.9 a CFMutableArray created with NULL
+// callbacks does not retain its elements, so the SecCertificate/SecPolicy objects
+// are released before SecTrust uses them -> use-after-free / __dynamic_cast
+// SIGSEGV. Passing kCFTypeArrayCallBacks makes the array retain its elements.
+// (The symbol is a CoreFoundation data global; it cannot be reached via
+// //go:cgo_import_dynamic address relocation cgo-free, so dlsym is used.)
+var kCFTypeArrayCallBacksAddr = func() uintptr {
+	name := []byte("kCFTypeArrayCallBacks\x00")
+	p := unsafe.Pointer(&name[0])
+	// dlsym(RTLD_DEFAULT, name); RTLD_DEFAULT == -2 on darwin.
+	r := syscall(abi.FuncPCABI0(x509_dlsym_trampoline), ^uintptr(1), uintptr(p), 0, 0, 0, 0)
+	runtime.KeepAlive(name)
+	return r
+}()
 
 func CFArrayCreateMutable() CFRef {
-	ret := syscall(abi.FuncPCABI0(x509_CFArrayCreateMutable_trampoline), kCFAllocatorDefault, 0, 0 /* kCFTypeArrayCallBacks */, 0, 0, 0)
+	ret := syscall(abi.FuncPCABI0(x509_CFArrayCreateMutable_trampoline), kCFAllocatorDefault, 0, kCFTypeArrayCallBacksAddr, 0, 0, 0)
 	return CFRef(ret)
