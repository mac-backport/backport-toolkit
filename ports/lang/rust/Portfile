if {${os.platform} eq "darwin" && ${os.major} > 15} {
    # (CURRENT) macOS 10.12 and later
    checksums-append        rustc-${version}-src${extract.suffix} \
                            rmd160  341e5c5eeb456cc617d9562fe162c988f44d7fa1 \
                            sha256  b226aef375ffbe9fbe2b85fde996b50716d59d55268e240d052396534b75e929 \
                            size    529275763

    patchfiles-append       patch-symlink.diff
} else {
    # backport-toolkit overlay: Checksums fuer rustc-1.95.0-src.tar.gz
    # (upstream-verifiziert gegen static.rust-lang.org .sha256). Default-Suffix
    # .tar.gz (kein use_xz). Entfernen sobald Version wieder folgt Upstream.
    checksums-append        rustc-${version}-src${extract.suffix} \
                            rmd160  efafbd5fce6e35434fdc79a6f18e831993b09541 \
                            sha256  ea9b82a83e46967537c3569ce9d6fa16811c043a96e651376c349e70241ca515 \
                            size    516130239
}

patchfiles-append           patch-offline_bootstrap.diff

# backport-toolkit overlay (macOS 10.9/10.10, Darwin 13-14): auf Mavericks/
# Yosemite meldet pthread_get_stacksize_np() fuer den MAIN-Thread faelschlich
# 512 KiB statt RLIMIT_STACK (~8 MiB); stack top (pthread_get_stackaddr_np) ist
# korrekt. std platziert die stack-overflow-Guard-Page daher ~512 KiB unter dem
# Top -- IN den lebenden Stack -- und tiefe (legale) Rekursion faultet als
# falscher "stack overflow". patch-mavericks_main_stack fixt das ERZEUGTE std
# (get_stack_start: Main-Thread via pthread_main_np + getrlimit). Das crashende
# `bootstrap`-Binary linkt aber stage0-std (ungepatcht) -> patch-mavericks_
# bootstrap_stack laesst bootstrap auf einem Spawned-Thread mit grossem Stack
# laufen (Spawned-Threads melden ihre Groesse korrekt). Ref rust-lang/rust#43347.
if { ${os.platform} eq "darwin" && ${os.major} < 15 } {
    patchfiles-append       patch-mavericks_main_stack.diff \
                            patch-mavericks_bootstrap_stack.diff
}

if { ${os.platform} eq "darwin" && ${os.major} < 16 } {
    # follow LLVM
    # see https://github.com/llvm/llvm-project/blob/01f924d0e37a5deae51df0d77e10a15b63aa0c0f/clang/lib/Driver/ToolChains/Arch/X86.cpp#L79-L82
    patchfiles-append       patch-old_procs.diff
}

if { ${os.platform} eq "darwin" && ${os.major} < 15 } {
    # follow LLVM
    # see https://github.com/llvm/llvm-project/blob/378778a0d10c2f8d5df8ceff81f95b6002984a4b/clang/lib/Driver/ToolChains/Darwin.cpp#L1203
    patchfiles-append       patch-old_dwarf_version.diff
}

if { ${os.platform} eq "darwin" && ${os.major} < 14 } {
    # revert https://github.com/llvm/llvm-project/commit/9902a0945d22cd5757b16ebe85fe07059723aa09
    # qos.h was introduced in 10.10
    patchfiles-append       patch-no_qos.diff
}

if { ${os.platform} eq "darwin" && ${os.major} < 12 } {
    # ___emutls_get_address and ___muloti4
    # see https://github.com/rust-lang/rust/commit/8a6ff90a3a41e6ace18aeb089ea0a0eb3726dd08
    rust.add_compiler_runtime   yes
}

