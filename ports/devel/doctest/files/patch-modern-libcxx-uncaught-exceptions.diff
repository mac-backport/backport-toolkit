--- doctest/doctest.h.orig
+++ doctest/doctest.h
@@ -6432,10 +6432,15 @@
 
 bool has_uncaught_exceptions() {
 // Derived from https://github.com/uxlfoundation/oneTBB/blob/v2023.0.0/include/oneapi/tbb/detail/_config.h#L342
+/* MacPorts backport (macOS 10.9): macports-libcxx is not availability-gated and
+   provides std::uncaught_exceptions() for every deployment target, 10.9 included.
+   Upstream only trusts it from macOS 10.12 on, which targets Apple's system
+   libc++. Without the _LIBCPP_VERSION escape the C++20 build falls back to
+   std::uncaught_exception() -- removed in C++20 -- and fails to compile. */
 #if (defined(_MSC_VER) && _MSC_VER >= 1900) ||                                                                         \
     (defined(__cpp_lib_uncaught_exceptions) && __cpp_lib_uncaught_exceptions >= 201411L &&                             \
      (!defined(_LIBCPP_VERSION) || !defined(__MAC_OS_X_VERSION_MIN_REQUIRED) ||                                        \
-      __MAC_OS_X_VERSION_MIN_REQUIRED >= 101200))
+      __MAC_OS_X_VERSION_MIN_REQUIRED >= 101200 || _LIBCPP_VERSION >= 160000))
     return (std::uncaught_exceptions() > 0);
 #else
     return std::uncaught_exception();
