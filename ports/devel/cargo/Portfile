# On unsupported hosts, configure.build_arch can be empty while the Portfile is
# still opened for mirroring. Only derive the bootstrap cargo path when there
# is a concrete build architecture.
if {${configure.build_arch} ne ""} {
    lassign             [rust_build.stage0_info ${configure.build_arch}] stage0_version stage0_arch
    cargo.bin           ${workpath}/cargo-${stage0_version}-[option triplet.${stage0_arch}]/cargo/bin/cargo
}

cargo.update            yes

# backport-toolkit overlay (macOS 10.9 / Darwin 13-14): nativer, SELF-HOSTENDER
# Build. Bootstrap-cargo = installiertes natives cargo (${prefix}/bin/cargo,
# DYLD-frei); RUSTC ist ohnehin ${prefix}/bin/rustc (nativ, gepatchtes std, via
# PortGroup rust). Statisches MLS (libMacportsLegacySupport.a) via PortGroup rust
# -> produziertes cargo nativ/DYLD-frei. rust-backport wird als Stage0 NICHT mehr
# gebraucht; es bleibt vorerst installiert als Netz, bis ein Self-Hosting-Build
# das bestaetigt -> dann retiren. FALLBACK falls natives cargo mal streikt:
# cargo.bin -> ${prefix}/libexec/rust-backport/bin/cargo, depends_build
# port:rust-backport, und DYLD-Env (extract/build/destroot) wieder aktivieren.
if {${os.platform} eq "darwin" && ${os.major} <= 16} {
    configure.compiler          macports-clang-22
    cargo.bin                   ${prefix}/bin/cargo
    # kein cargo.update-Refresh noetig: exakte Cargo.lock im Source, 507 Crates
    # schon im cargo-home (rust::handle_crates); Default ist ohnehin no.
    cargo.update                no
    configure.cflags-append     -isystem${prefix}/include/LegacySupport
    configure.cxxflags-append   -isystem${prefix}/include/LegacySupport
    configure.env-append        SDKROOT=/
    build.env-append            SDKROOT=/
    destroot.env-append         SDKROOT=/

    # Stage0-Download neutralisieren: rust_build::callback haengt sonst einen
    # prebuilt Stage0-cargo als Distfile an, den wir nicht brauchen (Bootstrap ist
    # das installierte native cargo). Die 507 cargo.crates (cargos Deps) bleiben
    # unberuehrt (rust::handle_crates). Nur der ≤16-Zweig; modern-Zweig unberuehrt.
    proc rust_build::callback {} {}
}

if { ${os.platform} eq "darwin" && ${os.major} < 10 } {
    # CFURLSetResourcePropertyForKey was introduced in 10.6, so turn off the (optional) function that uses it
    patchfiles-append   patch-no_CFURLSetResourcePropertyForKey.diff
}

# Use MacPorts curl
# https://doc.rust-lang.org/cargo/commands/cargo-install.html
# Features of direct dependencies may be enabled with <dep-name>/<feature-name> syntax.
build.args-append       --features curl-sys/force-system-lib-on-osx

destroot {
    xinstall            ${worksrcpath}/target/[cargo.rust_platform]/release/cargo \
                        ${destroot}${prefix}/bin

    xinstall -m 0644    {*}[glob ${worksrcpath}/src/etc/man/*] \
                        ${destroot}${prefix}/share/man/man1

    xinstall -d         ${destroot}${prefix}/share/doc/${subport}
    xinstall -m 0644 -W ${worksrcpath} \
                        LICENSE-APACHE LICENSE-MIT LICENSE-THIRD-PARTY README.md \
                        ${destroot}${prefix}/share/doc/${subport}

    xinstall -d         ${destroot}${prefix}/etc/bash_completion.d
    xinstall -m 0644    ${worksrcpath}/src/etc/cargo.bashcomp.sh \
                        ${destroot}${prefix}/etc/bash_completion.d/${subport}

    xinstall -d         ${destroot}${prefix}/share/zsh/site-functions
    xinstall -m 0644    ${worksrcpath}/src/etc/_cargo \
                        ${destroot}${prefix}/share/zsh/site-functions
}

