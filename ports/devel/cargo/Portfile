name                    cargo

if {${os.platform} eq "darwin" && ${os.major} > 16} {
    # (CURRENT) macOS 10.13 and later
    github.setup        rust-lang ${name} 0.99.0
    rust_build.version  1.98.0
    revision            0
} else {
    # macOS 10.12 and earlier
    # backport-toolkit overlay (10.9): von frozen 0.79.0/rust 1.78 auf 0.96.0/
    # rust 1.95 gehoben (passend zum nativen rust 1.95). Nativ via clang-22 +
    # rust-backport-Stage0 + statisches MLS (PortGroup rust). cargo.crates aus
    # src/tools/cargo/Cargo.lock von rustc-1.95.0-src generiert.
    github.setup        rust-lang ${name} 0.96.0
    rust_build.version  1.95.0
    revision            0

    # NOTE: The mirror_all_architectures variant doesn't currently work with
    # this pinned version.
}

